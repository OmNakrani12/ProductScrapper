# Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend environment variables
DATABASE_URL=sqlite:///./webcontact.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/webcontact_db

REDIS_URL=redis://localhost:6379/0

# Crawler configuration limits
MAX_PAGES_PER_SITE=5
REQUEST_TIMEOUT=15
MAX_CONCURRENT_SITES=5
REQUEST_DELAY=0.5
USE_PLAYWRIGHT_FALLBACK=true

# Security
SECRET_KEY=webcontact_ai_secret_key_change_in_production

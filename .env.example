# Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend environment variables
DATABASE_URL=sqlite:///./webcontact.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/webcontact_db
# For Managed Cloud PostgreSQL (Neon / Supabase - Free Tiers):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local dev (standalone Redis):
REDIS_URL=redis://localhost:6379/0
# Docker Compose:
# REDIS_URL=redis://redis:6379/0
# Cloud (Railway/Upstash):
# REDIS_URL=redis://default:password@redis-host:6379/0

# Crawler configuration limits
MAX_PAGES_PER_SITE=3
REQUEST_TIMEOUT=15
MAX_CONCURRENT_SITES=2
REQUEST_DELAY=0.5
USE_PLAYWRIGHT_FALLBACK=true

# Security
SECRET_KEY=webcontact_ai_secret_key_change_in_production

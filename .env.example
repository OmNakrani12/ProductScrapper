# Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend environment variables
DATABASE_URL=sqlite:///./webcontact.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/webcontact_db
# For Managed Cloud PostgreSQL (Neon / Supabase - Free Tiers):
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# Local dev (standalone Redis):
REDIS_URL=redis://localhost:6379/0
# Docker Compose:
# REDIS_URL=redis://redis:6379/0
# Cloud (Railway/Upstash):
# REDIS_URL=redis://default:password@redis-host:6379/0

# Crawler configuration limits (Optimized for Render 512MB RAM)
MAX_PAGES_PER_SITE=3
REQUEST_TIMEOUT=15
MAX_CONCURRENT_SITES=2
REQUEST_DELAY=0.5
# Set to false on Render 512MB tier. Jina AI proxy handles JS rendering with 0MB RAM.
USE_PLAYWRIGHT_FALLBACK=false
MAX_RESPONSE_BODY_BYTES=2500000
# Disable mobile & phone extraction for maximum performance and efficiency
EXTRACT_PHONES=false

# Security & Linux Memory Optimization
SECRET_KEY=webcontact_ai_secret_key_change_in_production
MALLOC_ARENA_MAX=2

# Google Gemini AI & Key Rotator
# Add multiple API keys separated by commas for automatic error failover and rate-limit rotation
# Models: gemini-3.8-flash (recommended), gemini-3.6-flash, gemini-3.5-flash-lite, gemini-4-argon
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_API_KEY=your_gemini_key_1
GEMINI_MODEL=gemini-3.8-flash


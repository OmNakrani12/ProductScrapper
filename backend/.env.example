# Database & Queue configuration
# Defaults to SQLite if PostgreSQL is not specified
DATABASE_URL=sqlite:///./webcontact.db
# For PostgreSQL in Docker or production:
# DATABASE_URL=postgresql://user:password@localhost:5432/webcontact

# Local dev (standalone Redis):
REDIS_URL=redis://localhost:6379/0
# Docker Compose:
# REDIS_URL=redis://redis:6379/0
# Cloud Deployment (Railway/Render/Upstash):
# REDIS_URL=redis://default:password@redis-cloud-host.com:6379/0

# Scraping configuration limits (Optimized for 512MB RAM containers like Render Free/Starter)
MAX_PAGES_PER_SITE=3
REQUEST_TIMEOUT=15
MAX_CONCURRENT_SITES=2
REQUEST_DELAY=0.5
# Set to false on Render (512MB RAM). Jina AI proxy handles JS-rendered pages and Cloudflare bypass with 0MB RAM.
# Only set to true if running on instances with 1GB+ RAM.
USE_PLAYWRIGHT_FALLBACK=false
MAX_RESPONSE_BODY_BYTES=2500000
# Disable mobile & phone extraction for maximum performance and efficiency
EXTRACT_PHONES=false

# Security & Linux Memory Optimization
SECRET_KEY=webcontact_ai_secret_key_change_in_production
MALLOC_ARENA_MAX=2

